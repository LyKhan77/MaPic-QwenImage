# Nilai yang dibutuhkan saat BUILD image frontend (Vite menanamnya ke bundle).
# Salin file ini menjadi .env lalu isi nilainya.
#
# Kredensial runtime backend TIDAK di sini — backend membaca ../../backend/.env
# lewat env_file, jadi rahasia tidak perlu diduplikasi.

# URL backend yang dijangkau browser. Ganti bila IP server berubah,
# lalu build ulang image frontend.
VITE_API_URL=http://192.168.2.142:8281/api

# Supabase — anon key aman untuk publik (dilindungi RLS).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsional: lokasi folder model di host.
# MODELS_DIR=/home/gspe-ai2/project_AI/qwen21-gguf
# CUTOUT_MODELS_DIR=/home/gspe-ai2/project_AI/mapic-rembg

# Opsional: mode multi-GPU (contoh untuk server gspe-ai3, default node index 2).
# COMPOSE_PROFILES=multi-gpu
# COMFY_GPU_1=1
# COMFY_GPU_2=2
# QWEN_GPU_WORKERS=1=http://comfyui:8188,2=http://comfyui-gpu2:8188
# QWEN_DEFAULT_GPU=2
