SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
QWEN_IMAGE_API_URL="http://localhost:30000"
QWEN_DEFAULT_RESOLUTION="1024"
# Batas resolusi endpoint service; samakan dengan QWEN_MAX_RESOLUTION layanan qwen-image.
QWEN_MAX_RESOLUTION="1024"
CORS_ORIGINS="http://localhost:5151,http://192.168.2.142:5151"
# Token mesin untuk endpoint service (/api/service/generate), dipakai backend lokal
# Inkspire. Biarkan kosong untuk mematikan endpoint service (HTTP 503) — endpoint
# pengguna tidak terpengaruh. Isi di server dengan nilai acak, mis.
# `openssl rand -hex 32`; jangan commit nilai asli.
MAPIC_SERVICE_TOKEN=""
