# Root level .gitignore for MaPic project

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# Build artifacts
build/
dist/

# Temporary files
tmp/
temp/
*.tmp
*test/
mapic-glm.service
start-mapic-glm.sh
# Documentation — hanya dokumen inti yang dilacak; sisanya diabaikan
*.md
!README.md
!API.md
!ARCHITECTURE.md
!WORKFLOW.md
!database-schema.md
!vercel-docs.md
!AGENTS.md
!CLAUDE.md
.gemini/

# Superpowers plans & specs are tracked as session records
!docs/superpowers/plans/
!docs/superpowers/plans/*.md
!docs/superpowers/specs/
!docs/superpowers/specs/*.md

# Test files
test_*.py
*_test.py
tests/
# Smoke test server inference ikut di-track (bukan unit test)
!qwen_image_server/smoke_test.py

# Rahasia environment — jangan pernah di-commit (contoh tetap dilacak)
**/.env
**/.env.local
!**/.env.example

# Qwen-Image inference server venv + HF cache
qwen_image_server/.venv/
qwen_image_server/venv/
qwen_image_server/__pycache__/
models/
.vercel
# Unit systemd host-specific (dibuat di server, bukan di repo)
deploy/*.service
qwen-image.service
