# Root level .gitignore for MaPic project

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# Build artifacts
build/
dist/

# Temporary files
tmp/
temp/
.cooper/context/
*.tmp
*test/
# Dokumentasi produk dilacak; catatan sesi (plans dan specs) tetap lokal.
docs/plans/
docs/superpowers/plans/
docs/superpowers/specs/
.gemini/
.commandcode/

# Test files
test_*.py
*_test.py
tests/
# Smoke test server inference ikut di-track (bukan unit test)
!qwen_image_server/smoke_test.py

# Rahasia environment — jangan pernah di-commit (contoh tetap dilacak)
**/.env
**/.env.local
!**/.env.example

# Qwen-Image inference server venv + HF cache
qwen_image_server/.venv/
qwen_image_server/venv/
qwen_image_server/__pycache__/
models/
.vercel
# Unit systemd host-specific (dibuat di server, bukan di repo)
deploy/*.service
qwen-image.service

# Playwright MCP artifacts (screenshots, console logs, snapshots)
.playwright-mcp/

# Artefak task runner Pi (log perintah background)
.pi/
