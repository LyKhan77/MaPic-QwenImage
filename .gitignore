# Root level .gitignore for MaPic project

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log

# Build artifacts
build/
dist/

# Temporary files
tmp/
temp/
*.tmp
*test/
mapic-glm.service
start-mapic-glm.sh
# Documentation (keep only README.md)
*.md
!README.md
.gemini/
!database-schema.md
!vercel-docs.md
!API.md

# Superpowers plans & specs are tracked as session records
!docs/superpowers/plans/
!docs/superpowers/plans/*.md
!docs/superpowers/specs/
!docs/superpowers/specs/*.md

# Test files
test_*.py
*_test.py
tests/

# GLM-Image server venv + HF cache
glm_image_server/.venv/
glm_image_server/venv/
glm_image_server/__pycache__/
models/
.vercel
